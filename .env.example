# Overemployed-Job Bot — environment template
# Copy to .env and fill real values. Never commit .env.

# Required. Generate a long random string for production.
SECRET_KEY=change-me-generate-a-long-random-value

# Optional. 32-byte urlsafe Fernet key (44 chars ending in =).
# If empty, a key is derived from SECRET_KEY (changing SECRET_KEY then breaks decryption).
ENCRYPTION_KEY=

# App bind
APP_HOST=127.0.0.1
APP_PORT=8743

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Job scanners (public JSON APIs only, never login-walled sites). Comma-separated; empty disables all.
SCANNERS_ENABLED=remotive,remoteok,arbeitnow,hn,greenhouse,lever,ashby,workable,smartrecruiters,recruitee
# Scan every company in data/companies.json (refreshed weekly by a GitHub Action).
USE_COMPANY_REGISTRY=true
# Extra public board slugs on top of the registry, e.g. GREENHOUSE_BOARDS=acme,globex
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
ASHBY_BOARDS=
WORKABLE_ACCOUNTS=
SMARTRECRUITERS_COMPANIES=
RECRUITEE_COMPANIES=
SCAN_INTERVAL_MINUTES=60
# Boards fetched per cycle; a full sweep rotates across cycles to stay polite.
BOARDS_PER_CYCLE=300
PER_HOST_CONCURRENCY=4
PER_HOST_MIN_INTERVAL_SECONDS=0.25
HTTP_RETRIES=3
# "all" keeps every listing for purpose matching; "applicable" keeps the legacy non-engineering filter.
CATALOG_FILTER=all
JOB_RETENTION_DAYS=45

# Purpose matching (free, local). Embeddings need: pip install sentence-transformers
MATCH_EMBEDDINGS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
MATCH_RATE_LIMIT=60

# Optional integrations (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
