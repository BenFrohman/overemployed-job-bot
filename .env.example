# Overemployed-Job Bot — environment template
# Copy to .env and fill real values. Never commit .env.

# Required. Generate a long random string for production.
SECRET_KEY=change-me-generate-a-long-random-value

# Optional. 32-byte urlsafe Fernet key (44 chars ending in =).
# If empty, a key is derived from SECRET_KEY (changing SECRET_KEY then breaks decryption).
ENCRYPTION_KEY=

# App bind
APP_HOST=127.0.0.1
APP_PORT=8743

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Billing — $20 lifetime plan (cents). CI asserts this exact assignment.
STRIPE_PRICE_LIFETIME_CENTS=2000
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional integrations (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
